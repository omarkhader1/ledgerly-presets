        {
          "name": "Arab Bank - Cash withdrawal",
          "description": "ATM cash withdrawals",
          "keyword": "حركة سحب",
          "actions": [
            {
              "actionType": "Regex Extract",
              "targetColumn": "Amount",
              "value": "بمبلغ ([\\d.]+) JOD"
            },
            {
              "actionType": "Set Value",
              "targetColumn": "Merchant",
