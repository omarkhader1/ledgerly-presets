{
  "schema": 2,
  "catalogVersion": 2,
  "presets": [
    {
      "id": "jo-arab-bank",
      "name": "Arab Bank",
      "kind": "bank",
      "country": "JO",
      "updatedAt": "2026-10-27",
      "description": "Arabic SMS alerts: card purchases, cash withdrawals, CliQ payments in and out, transfers in, out and between your accounts, and bill payments.",
      "senders": [
        "ArabBank",
        "Arab Bank"
      ],
      "notificationApps": [],
      "rules": [
        {
          "name": "Arab Bank - Transfer between my accounts",
          "description": "Transfers from one of your accounts to another",
          "keyword": "حوالة && من حساب && لحساب",
          "actions": [
            {
              "actionType": "Extract Between",
              "targetColumn": "Amount",
              "value": "\\QJOD\\E\\s*([\\p{L}\\p{N}\\s\\.,\\$\\*#/\\-]+?)(?:\\s*\\Qمن\\E|$)",
              "prefix": "JOD ",
              "suffix": " من",
              "extractMode": "BETWEEN"
            },
            {
              "actionType": "Set Value",
              "targetColumn": "Merchant",
              "value": "Internal Transfer",
              "prefix": "",
              "suffix": "",
              "extractMode": "STATIC"
            },
            {
              "actionType": "Set Value",
              "targetColumn": "Type",
              "value": "Transfer",
              "prefix": "",
              "suffix": "",
              "extractMode": "STATIC"
            },
            {
              "actionType": "Regex Extract",
              "targetColumn": "Account",
              "value": "من حساب\\s*[0-9]*\\*?([0-9]+)"
            },
            {
              "actionType": "Regex Extract",
              "targetColumn": "Destination Account",
              "value": "لحساب\\s*[0-9]*\\*?([0-9]+)"
            }
          ],
          "samples": [
            {
              "message": "حوالة بمبلغ JOD 50.000 من حساب 0100*4567 لحساب 0100*8910 .",
              "amount": 50.0,
              "merchant": "Internal Transfer",
              "type": "Transfer"
            }
          ]
        },
        {
          "name": "Arab Bank - Card purchase",
          "description": "Card purchases",
          "keyword": "حركة شراء",
          "actions": [
            {
              "actionType": "Extract Between",
              "targetColumn": "Amount",
              "value": "\\QJOD\\E\\s*([A-Za-z0-9\\s\\.,\\$]+?)(?:\\s*\\Qبتاريخ\\E|$)",
              "prefix": "JOD ",
              "suffix": " بتاريخ",
              "extractMode": "BETWEEN"
            },
            {
              "actionType": "Extract Between",
              "targetColumn": "Merchant",
              "value": "\\*\\d+\\s+من\\s+(.+?)\\s+بمبلغ",
              "prefix": "",
              "suffix": " ",
              "extractMode": "BETWEEN"
            },
            {
              "actionType": "Set Value",
              "targetColumn": "Type",
              "value": "Expense",
              "prefix": "",
              "suffix": "",
              "extractMode": "STATIC"
            }
          ],
          "samples": [
            {
              "message": "حركة شراء على البطاقة *1234 من CARREFOUR بمبلغ JOD 12.500 بتاريخ 27/10/2026 .الرصيد 300.000 دينار",
              "amount": 12.5,
              "merchant": "CARREFOUR",
              "type": "Expense"
            }
          ]
        },
        {
          "name": "Arab Bank - CliQ payment sent",
          "description": "CliQ payments you send",
          "keyword": "دفعة كليك && إلى",
          "actions": [
            {
              "actionType": "Extract Between",
              "targetColumn": "Amount",
              "value": "\\Qبمبلغ\\E\\s*([A-Za-z0-9\\s\\.,\\$]+?)(?:\\s*\\Qمن\\E|$)",
              "prefix": "بمبلغ ",
              "suffix": " من",
              "extractMode": "BETWEEN"
            },
            {
              "actionType": "Extract Between",
              "targetColumn": "Merchant",
              "value": "\\Qإلى\\E\\s*([A-Za-z0-9\\s\\.,\\$]+?)(?:\\s*\\Qالرصيد\\E|$)",
              "prefix": "إلى ",
              "suffix": "الرصيد",
              "extractMode": "BETWEEN"
            },
            {
              "actionType": "Set Value",
              "targetColumn": "Type",
              "value": "Expense",
              "prefix": "",
              "suffix": "",
              "extractMode": "STATIC"
            }
          ],
          "samples": [
            {
              "message": "دفعة كليك بمبلغ 20.000 من حسابك إلى AHMAD ALI الرصيد 280.000",
              "amount": 20.0,
              "merchant": "AHMAD ALI",
              "type": "Expense"
            }
          ]
        },
        {
          "name": "Arab Bank - CliQ payment received",
          "description": "CliQ payments you receive",
          "keyword": "دفعة كليك && لحساب",
          "actions": [
            {
              "actionType": "Regex Extract",
              "targetColumn": "Amount",
