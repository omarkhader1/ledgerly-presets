      "description": "Card purchases and CliQ transfers received.",
      "senders": [
        "ArabBank",
        "Arab Bank"
      ],
      "notificationApps": [],
      "rules": [
        {
          "name": "Arab Bank - Card purchase",
          "description": "Debit card payments",
          "keyword": "debited",
          "actions": [
            {
              "actionType": "Regex Extract",
              "targetColumn": "Amount",
              "value": "debited with\\s*(?:JOD)?\\s*([0-9.,]+)"
            },
            {
              "actionType": "Regex Extract",
              "targetColumn": "Merchant",
              "value": "at\\s+(.*?)(?:\\s+on|\\.|$)"
            },
            {
              "actionType": "Set Value",
              "targetColumn": "Type",
              "value": "Expense"
            },
            {
              "actionType": "Set Value",
              "targetColumn": "Category",
              "value": "General"
            }
          ],
          "samples": [
            {
              "message": "Your card ending 1234 was debited with JOD 12.500 at CARREFOUR on 25/10/2026.",
              "amount": 12.5,
              "merchant": "CARREFOUR",
              "type": "Expense"
            }
          ]
        },
        {
          "name": "Arab Bank - CliQ received",
          "description": "Money received through CliQ",
          "keyword": "CliQ",
          "actions": [
            {
              "actionType": "Regex Extract",
              "targetColumn": "Amount",
              "value": "(?:received|credited with)\\s*(?:JOD)?\\s*([0-9.,]+)"
            },
            {
              "actionType": "Regex Extract",
              "targetColumn": "Merchant",
              "value": "from\\s+(.*?)(?:\\s+via|\\.|$)"
            },
            {
              "actionType": "Set Value",
              "targetColumn": "Type",
              "value": "Income"
            },
            {
              "actionType": "Set Value",
              "targetColumn": "Category",
              "value": "Transfer"
            }
          ],
          "samples": [
            {
              "message": "You have received JOD 50.000 from AHMAD ALI via CliQ.",
              "amount": 50.0,
              "merchant": "AHMAD ALI",
              "type": "Income",
              "category": "Transfer"
            }
          ]
        }
